{
  "name": "plantpulse",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "cd apps/api && python -m uvicorn app.main:app --reload",
    "dev:mobile": "npm run start --workspace=apps/mobile"
  }
}
